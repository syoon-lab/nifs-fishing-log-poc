<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#176B60</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/ReadableAlertDialogTheme</item>
        <item name="android:textViewStyle">@style/ReadableTextView</item>
        <item name="android:buttonStyle">@style/ReadableButton</item>
        <item name="android:editTextStyle">@style/ReadableEditText</item>
        <item name="android:checkboxStyle">@style/ReadableCheckBox</item>
        <item name="android:spinnerItemStyle">@style/ReadableSpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/ReadableSpinnerDropDown</item>
        <item name="android:textAppearanceLarge">@style/ReadableLargeText</item>
        <item name="android:textAppearanceListItem">@style/ReadableLargeText</item>
        <item name="android:listPreferredItemHeight">64dp</item>
        <item name="android:listPreferredItemHeightSmall">64dp</item>
    </style>
    <style name="ReadableAlertDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#176B60</item>
        <item name="android:textViewStyle">@style/ReadableTextView</item>
        <item name="android:buttonStyle">@style/ReadableButton</item>
        <item name="android:editTextStyle">@style/ReadableEditText</item>
        <item name="android:checkboxStyle">@style/ReadableCheckBox</item>
        <item name="android:spinnerItemStyle">@style/ReadableSpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/ReadableSpinnerDropDown</item>
        <item name="android:textAppearanceLarge">@style/ReadableLargeText</item>
        <item name="android:textAppearanceListItem">@style/ReadableLargeText</item>
        <item name="android:listPreferredItemHeight">64dp</item>
        <item name="android:listPreferredItemHeightSmall">64dp</item>
    </style>
    <style name="ReadableTextView" parent="android:style/Widget.Material.TextView">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="ReadableLargeText" parent="android:style/TextAppearance.Material.Large">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="ReadableButton" parent="android:style/Widget.Material.Button">
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="ReadableEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:textSize">26sp</item>
        <item name="android:minHeight">64dp</item>
    </style>
    <style name="ReadableCheckBox" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:textSize">22sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:singleLine">false</item>
    </style>
    <style name="ReadableSpinnerItem" parent="android:style/Widget.Material.TextView.SpinnerItem">
        <item name="android:textSize">24sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:singleLine">false</item>
    </style>
    <style name="ReadableSpinnerDropDown" parent="android:style/Widget.Material.DropDownItem.Spinner">
        <item name="android:textSize">24sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:singleLine">false</item>
    </style>
</resources>
